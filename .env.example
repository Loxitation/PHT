POSTGRES_DB=pht
POSTGRES_USER=pht
POSTGRES_PASSWORD=change-this-password
POSTGRES_PORT=5432

API_PORT=8000

# Dashboard (Vue 3 SPA, served via nginx). DASHBOARD_API_BASE_URL must be reachable from the
# user's browser (e.g. http://pht.leda:8000 or https://pht.loxitation.de), not an internal
# Docker service name.
DASHBOARD_PORT=8080
DASHBOARD_API_BASE_URL=http://localhost:8000

JWT_SECRET=change-this-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
LOGIN_RATE_LIMIT=5/minute

# Comma-separated list of browser origins allowed to call the API (needed for the dashboard SPA).
# Example: http://localhost:8080,https://pht.loxitation.de
CORS_ALLOWED_ORIGINS=http://localhost:8080

GOTIFY_ENABLED=false
GOTIFY_URL=
GOTIFY_TOKEN=

LOG_LEVEL=INFO
