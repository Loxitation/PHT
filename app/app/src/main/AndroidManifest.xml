<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bluetooth LE is required: this app only works with BLE health devices -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- API 31+ (Android 12+): new runtime-permission BLE model.
         neverForLocation is set because we only use scan results to find our own
         GATT service UUID, never to derive the user's physical location. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- API 26-30 (Android 8-11): legacy Bluetooth permissions -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Required by the platform on API 26-30 to receive BLE scan results. Both fine and coarse
         are declared together per Android's location-permission-pairing requirement, even
         though we only rely on fine-location-gated BLE scanning, never on actual location data. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Sync to the self-hosted PHT server -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".PhtApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PHT"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic=true: allows plain http:// to a LAN server (e.g. Nginx
             Proxy Manager on the local *.leda domain) in addition to https://*.loxitation.de.
             Restrict via a network security config if LAN access is later HTTPS-only. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PHT">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
