<?xml version="1.0" encoding="utf-8"?>
<!-- Only relevant on API 26-30 (Android 12+ uses data_extraction_rules.xml instead); since
     android:allowBackup is "false" this has no practical effect, but is set for completeness /
     to satisfy tooling that still checks for it below API 31. -->
<full-backup-content>
    <exclude domain="root" />
</full-backup-content>
